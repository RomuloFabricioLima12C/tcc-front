# Copie este arquivo para ".env" (no Windows: copy .env.example .env) e troque os valores.
# O ".env" NÃO vai para o GitHub (está no .gitignore), porque guarda senhas.

# Porta em que a API vai rodar
PORT=3000

# true = a API liga um PostgreSQL sozinha (dados em back/.banco-dados). Não precisa instalar nada.
# false = usa o banco do DATABASE_URL abaixo (instalado no computador ou na nuvem)
BANCO_LOCAL=true

# Só é usado com BANCO_LOCAL=false: postgres://USUARIO:SENHA@SERVIDOR:PORTA/NOME_DO_BANCO
DATABASE_URL=
# Use "true" se o banco estiver na nuvem e exigir SSL (Neon, Supabase, Render...)
DATABASE_SSL=false

# Segredo usado para assinar os tokens de login (JWT). Use uma frase longa e aleatória.
JWT_SECRET=troque-por-uma-frase-bem-longa-e-secreta

# Quanto tempo o login vale antes de precisar entrar de novo
JWT_EXPIRES_IN=7d

# Chave fixa que o ESP32 manda no cabeçalho "x-device-key"
DEVICE_KEY=labcam-2e6cfb01cf53

# Toda conta do site é dona da geladeira. Os dados das placas e da voz ficam guardados em nome desta
# conta (se ela não existir, da conta mais antiga). Pode deixar 1.
DEVICE_USER_ID=1

# Endereços do site que podem chamar a API (separados por vírgula). "*" libera todos.
CORS_ORIGIN=*

# Conta da casa (opcional): criada sozinha se o banco estiver vazio. Vira o usuário id 1,
# a conta que guarda os dados da geladeira. Vazio = a primeira conta criada no site.
CONTA_NOME=Familia Lab Cam
CONTA_EMAIL=
CONTA_SENHA=

# Quantas fotos da ESP32-CAM guardar por usuário (as mais antigas são apagadas)
FOTOS_GUARDADAS=30

# E-mail do "Esqueceu a senha?" (Brevo, grátis: 300 por dia). Chave em brevo.com > SMTP & API > API Keys.
# EMAIL_REMETENTE precisa estar confirmado no Brevo (Senders). Sem a chave, o código aparece só no terminal.
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=LightLab

# AI Voice (Xiaozhi): cole o endereço MCP (wss://...) do painel xiaozhi.me. Vazio = voz desligada.
XIAOZHI_MCP_ENDPOINT=
